// Resources of "PiratesAtWorldsEnd Launcher.exe": icon (res/icon.ico, when present), file properties, and
// the launcher's fonts and art (launcher/resources.h).
#include <winver.h>
#include "version.h"
#include "launcher_version.h"
#include "resources.h"

#ifdef POTCAWERECOMP_HAS_ICON
1 ICON "icon.ico"
#endif

IDR_FONT_REGULAR RCDATA "fonts/Barlow-Regular.ttf"
IDR_FONT_MEDIUM RCDATA "fonts/Barlow-Medium.ttf"
IDR_FONT_SEMIBOLD RCDATA "fonts/Barlow-SemiBold.ttf"
IDR_FONT_BOLD RCDATA "fonts/Barlow-Bold.ttf"
IDR_FONT_CONDENSED_SEMIBOLD RCDATA "fonts/BarlowCondensed-SemiBold.ttf"
IDR_FONT_CONDENSED_BOLD RCDATA "fonts/BarlowCondensed-Bold.ttf"
IDR_ART_HERO RCDATA "art/hero.svg"
IDR_ART_INSTALL RCDATA "art/install.svg"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RECOMP_LAUNCHER_VERSION
PRODUCTVERSION POTCAWERECOMP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "PiratesAtWorldsEnd Launcher - options for POTCAWERecomp"
      VALUE "FileVersion", RECOMP_LAUNCHER_VERSION_STR
      VALUE "ProductName", "POTCAWERecomp"
      VALUE "ProductVersion", POTCAWERECOMP_VERSION_STR
      VALUE "OriginalFilename", "PiratesAtWorldsEnd Launcher.exe"
      VALUE "LegalCopyright", "POTCAWERecomp code: MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
