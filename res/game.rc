// Resources of PiratesAtWorldsEndRecomp.exe: icon (res/icon.ico, when present) and file properties.
#include <winver.h>
#include "version.h"

#ifdef POTCAWERECOMP_HAS_ICON
1 ICON "icon.ico"
#endif

// Button pictures for controllers whose art is not on the game's disc (src/button_prompts.cpp), made by
// prompts/make_prompts.py from Xelu's Free Controller & Key Prompts (CC0).
PROMPT_PS5_OPTIONS_GLYPH RCDATA "prompts/ps5_options_glyph.png"
PROMPT_PS5_CREATE_GLYPH RCDATA "prompts/ps5_create_glyph.png"
PROMPT_PS4_OPTIONS_GLYPH RCDATA "prompts/ps4_options_glyph.png"
PROMPT_PS4_SHARE_GLYPH RCDATA "prompts/ps4_share_glyph.png"
PROMPT_PS5_OPTIONS_SPRITE RCDATA "prompts/ps5_options_sprite.png"
PROMPT_PS5_CREATE_SPRITE RCDATA "prompts/ps5_create_sprite.png"
PROMPT_PS4_OPTIONS_SPRITE RCDATA "prompts/ps4_options_sprite.png"
PROMPT_PS4_SHARE_SPRITE RCDATA "prompts/ps4_share_sprite.png"
PROMPT_XBOX_MENU_GLYPH RCDATA "prompts/xbox_menu_glyph.png"
PROMPT_XBOX_VIEW_GLYPH RCDATA "prompts/xbox_view_glyph.png"
PROMPT_XBOX_MENU_SPRITE RCDATA "prompts/xbox_menu_sprite.png"
PROMPT_XBOX_VIEW_SPRITE RCDATA "prompts/xbox_view_sprite.png"
// The keyboard's keys (src/keyboard_prompts.cpp): two atlases and their index.
PROMPT_KEYS_GLYPH RCDATA "prompts/keys_glyph.png"
PROMPT_KEYS_SPRITE RCDATA "prompts/keys_sprite.png"
PROMPT_KEYS_INDEX RCDATA "prompts/keys.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION POTCAWERECOMP_VERSION
PRODUCTVERSION POTCAWERECOMP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Pirates of the Caribbean: At World's End - POTCAWERecomp"
      VALUE "FileVersion", POTCAWERECOMP_VERSION_STR
      VALUE "ProductName", "POTCAWERecomp"
      VALUE "ProductVersion", POTCAWERECOMP_VERSION_STR
      VALUE "OriginalFilename", "PiratesAtWorldsEndRecomp.exe"
      VALUE "LegalCopyright", "POTCAWERecomp code: MIT License. Game content belongs to its owners."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
