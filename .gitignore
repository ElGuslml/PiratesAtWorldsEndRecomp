# Game files: you provide your own (see assets/README.md)
assets/*
!assets/README.md

# Generated by the codegen during the build (only the CMake entry point is tracked)
generated/*
!generated/rexglue.cmake

# Build output
out/

# RenderDoc captures and their analysis (tools/renderdoc)
captures/

# Personal tools: investigation scripts, switch-table checker, gap finder (not published). Only the
# repository root's tools/: NativeXRenderer's own tools in native_x_renderer/tools/ are tracked.
/tools/

# Python caches of the tools
__pycache__/

# Personal notes for Claude Code: local paths, machine (CLAUDE.md is tracked)
CLAUDE.local.md

# Detailed investigation notes, per run (not published; the short public version is docs/)
local_docs/

*.log
